{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fincra Account Resolution Conversions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Conversions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Initiate a currency conversion",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fincra.com/conversions/initiate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Convert balance from one currency to another using a quote reference."
        },
        {
          "info": {
            "name": "List all conversions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fincra.com/conversions",
            "params": [
              {
                "name": "business",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "perPage",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List all conversions"
        },
        {
          "info": {
            "name": "Verify conversion status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fincra.com/conversions/:reference",
            "params": [
              {
                "name": "reference",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Verify conversion status"
        }
      ]
    }
  ],
  "bundled": true
}